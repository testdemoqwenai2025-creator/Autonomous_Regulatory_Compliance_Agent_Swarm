# ── Database ────────────────────────────────────────────────
DB_DRIVER=sqlite
# DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maritime_compliance
DB_USER=postgres
DB_PASSWORD=mysecretpassword
DB_SSL_MODE=prefer
SQLITE_PATH=data/compliance.db

# ── PII Anonymiser ──────────────────────────────────────────
TOKEN_PREFIX=MTS
HASH_ALGO=SHA256
HMAC_KEY=change-me-to-a-strong-random-key
DATE_MASK=****-**-**
PRESERVE_DOMAIN=true

# ── EDI Auditor ─────────────────────────────────────────────
FMS_CONNECTION_STRING=
AUDIT_BATCH_SIZE=1000
CHECK_ENCRYPTION=true
CHECK_CUSTOMS_DOCS=true
CHECK_EDI_COMPLIANCE=true
MAX_UNENCRYPTED_AGE_HOURS=24

# ── Remediation ─────────────────────────────────────────────
AUTO_APPLY_POLICIES=false
EDI_UPDATE_MODE=dry-run
POLICY_OUTPUT_DIR=policies/
NOTIFICATION_WEBHOOK=

# ── MTTR Tracker (Golang) ───────────────────────────────────
MTTR_HTTP_PORT=8080
MTTR_GRPC_PORT=50051
MTTR_FLUSH_INTERVAL=10
MTTR_RETENTION_DAYS=90

# ── General ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=
