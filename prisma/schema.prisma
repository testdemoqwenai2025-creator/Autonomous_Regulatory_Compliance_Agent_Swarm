// Maritime Global Compliance Swarm - Full Data Model
// Prisma Schema v3.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
//  CORE USERS & AUTH
// ═══════════════════════════════════════════════════════════════

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  role          String   @default("viewer")  // viewer | analyst | operator | admin
  apiKey        String?  @unique
  apiKeyHash    String?
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLog      AuditLog[]
}

// ═══════════════════════════════════════════════════════════════
//  COMPLIANCE FINDINGS
// ═══════════════════════════════════════════════════════════════

model ComplianceFinding {
  id              String   @id @default(cuid())
  findingRef      String   @unique
  severity        String   // critical | high | medium | low | info
  status          String   @default("open")  // open | in_progress | remediated | accepted_risk | false_positive | closed
  riskCategory    String   // pii_exposure | unencrypted_transmission | missing_customs_doc | edi_non_compliance | data_retention_violation | access_control_breach | cert_expiry | carbon_reporting
  title           String
  description     String   @default("")
  affectedSystem  String   @default("FMS")
  affectedTable   String   @default("")
  affectedRowCount Int    @default(0)
  evidence        String   @default("{}")  // JSON
  currentPhase    String   @default("detected")  // detected | triaged | assigned | in_remediation | awaiting_verification | verified | escalated | risk_accepted | closed
  weatherContext  String   @default("null")  // JSON or null
  jurisdiction    String   @default("GDPR")
  detectedAt      DateTime @default(now())
  remediatedAt    DateTime?
  verifiedAt      DateTime?
  closedAt        DateTime?
  mttrHours       Float?
  riskScore       Float    @default(0)

  transitions     FindingTransition[]
  reactions       ReactionLog[]
  dataSource      DataSource?    @relation(fields: [dataSourceId], references: [id])
  dataSourceId    String?
}

model FindingTransition {
  id              String   @id @default(cuid())
  findingId       String
  fromState       String
  toState         String
  trigger         String   // manual_triage | manual_assign | remediation_submitted | verification_passed | auto_escalate_timeout | manual_close | risk_accept | mark_false_positive
  actor           String   @default("system")
  contextPayload  String   @default("{}")  // JSON
  autoEscalated   Boolean  @default(false)
  timeoutHours    Int?
  createdAt       DateTime @default(now())

  finding         ComplianceFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@index([toState])
}

// ═══════════════════════════════════════════════════════════════
//  EDI PROFILES & MASKING POLICIES
// ═══════════════════════════════════════════════════════════════

model EdiConnectionProfile {
  id              String   @id @default(cuid())
  partnerId       String
  partnerName     String
  ediStandard     String   // EDIFACT | ANSI_X12 | BAPLIE | VGM | COPARN | IFTMBC | CUSTOMS
  encrypted       Boolean  @default(false)
  protocol        String   @default("None")
  tlsVersion      String?
  certExpiry      DateTime?
  lastAudit       DateTime?
  compliant       Boolean  @default(true)
  issues          String   @default("[]")  // JSON array
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MaskingPolicy {
  id              String   @id @default(cuid())
  name            String
  fieldName       String
  action          String   // tokenise | redact | generalise | pseudonymise | encrypt | truncate
  category        String?  // consignee_identity | shipper_identity | contact_info | financial_id | government_id | location
  gdprArticle     String   @default("")
  enabled         Boolean  @default(true)
  autoGenerated   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
//  EVENT BUS & REACTIONS
// ═══════════════════════════════════════════════════════════════

model ComplianceEvent {
  id              String   @id @default(cuid())
  eventType       String   // FINDING_CREATED | FINDING_STATE_CHANGED | AUDIT_COMPLETE | WEATHER_HOLD | REMEDIATION_APPLIED etc
  source          String   @default("system")
  correlationId   String?
  payload         String   @default("{}")  // JSON
  processed       Boolean  @default(false)
  createdAt       DateTime @default(now())

  reactions       ReactionLog[]

  @@index([eventType])
  @@index([processed])
}

model ReactionLog {
  id              String   @id @default(cuid())
  ruleId          String
  ruleName        String
  eventType       String
  findingId       String?
  actionTaken     String
  success         Boolean  @default(true)
  details         String   @default("{}")  // JSON
  createdAt       DateTime @default(now())

  finding         ComplianceFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  event           ComplianceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId         String

  @@index([ruleId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════
//  MTTR TRACKING
// ═══════════════════════════════════════════════════════════════

model MttrEvent {
  id              String   @id @default(cuid())
  findingRef      String
  phase           String   // identified | triaged | assigned | in_progress | awaiting_verification | resolved | verified | escalated | closed
  eventTs         DateTime @default(now())
  severity        String?
  riskCategory    String?

  @@index([findingRef])
  @@index([phase])
}

// ═══════════════════════════════════════════════════════════════
//  DATA SOURCE INTEGRATION
// ═══════════════════════════════════════════════════════════════

model DataSource {
  id              String   @id @default(cuid())
  name            String   // AIS | PCS | EU_ETS | BLOCKCHAIN_EBL | IOT_SENSOR | SATELLITE | FMS | CUSTOMS_SINGLE_WINDOW
  type            String   // stream | api | poll | webhook
  protocol        String   @default("rest")  // rest | mqtt | kafka | websocket | nmea
  endpoint        String?
  status          String   @default("active")  // active | degraded | down | pending
  lastIngestedAt  DateTime?
  recordCount     Int      @default(0)
  errorCount      Int      @default(0)
  config          String   @default("{}")  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  findings        ComplianceFinding[]
  ingestLogs      DataIngestLog[]
}

model DataIngestLog {
  id              String   @id @default(cuid())
  dataSourceId    String
  status          String   // success | error | partial
  recordsIngested Int      @default(0)
  recordsFailed   Int      @default(0)
  errorMessage    String?
  durationMs      Int?
  createdAt       DateTime @default(now())

  dataSource      DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@index([dataSourceId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════
//  ANOMALY DETECTION
// ═══════════════════════════════════════════════════════════════

model AnomalyRecord {
  id              String   @id @default(cuid())
  metricName      String   // edi_volume | pii_density | transmission_failures | cert_expiry_days
  dataSource      String?
  baselineValue   Float
  observedValue   Float
  zScore          Float
  threshold       Float   @default(2.0)
  severity        String   @default("info")  // info | warning | critical
  acknowledged    Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([metricName])
  @@index([severity])
  @@index([acknowledged])
}

// ═══════════════════════════════════════════════════════════════
//  AUDIT LOG & OBSERVABILITY
// ═══════════════════════════════════════════════════════════════

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  action          String
  resource        String
  details         String   @default("{}")  // JSON
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SystemEvent {
  id              String   @id @default(cuid())
  requestId       String
  path            String
  method          String
  middlewareTs     DateTime
  handlerTs       DateTime
  dbWriteTs       DateTime?
  dbReadMs        Int?
  statusCode      Int
  clientIp        String?
  userAgent       String?
  layerTrace      String   @default("{}")
  createdAt       DateTime @default(now())
}

model ComponentHealth {
  id              String   @id @default(cuid())
  component       String
  status          String
  latencyMs        Int
  details         String   @default("{}")
  checkedAt       DateTime @default(now())
}

model CorrelatedTrace {
  id                      String   @id @default(cuid())
  requestId               String
  path                    String
  method                  String
  statusCode              Int
  clientFetchStart        String
  clientTtfbMs            Int
  clientRoundTripMs       Int
  clientJsonParseMs       Int
  clientRenderStartMs     Int
  clientNetworkProtocol   String
  clientTimingJson        String
  serverMiddlewareStartTs String
  serverMiddlewareEndTs   String
  serverMiddlewareMs      Int
  serverHandlerStartTs    String
  serverHandlerEndTs      String
  serverHandlerMs         Int
  serverDbWriteMs         Int
  serverDbReadMs          Int
  clientServerDeltaMs     Int
  totalEndToEndMs         Int
  createdAt               DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
//  RATE LIMITING
// ═══════════════════════════════════════════════════════════════

model RateLimitEntry {
  id              String   @id @default(cuid())
  clientIp        String
  path            String
  requestCount    Int      @default(1)
  windowStart     DateTime @default(now())

  @@index([clientIp, path, windowStart])
}

// ═══════════════════════════════════════════════════════════════
//  FULL-SITE OBSERVABILITY — Endpoint Traces & Spans
// ═══════════════════════════════════════════════════════════════

model EndpointTrace {
  id                  String              @id @default(cuid())
  traceId             String              @unique   // client-generated correlation id
  requestId           String                        // middleware-injected x-request-id
  initiatedBy         String              @default("manual")  // manual | auto_page_load | auto_interval
  clientIp            String              @default("")
  userAgent           String              @default("")
  navigationType      String              @default("")
  connectionType      String              @default("")
  pageUrl             String              @default("")
  browserTtfbAvgMs    Float               @default(0)
  browserRoundTripAvgMs Float              @default(0)
  longTaskCount       Int                 @default(0)
  longTaskTotalMs     Int                 @default(0)
  memoryUsedMb        Float               @default(0)
  memoryLimitMb       Float               @default(0)
  domNodes            Int                 @default(0)
  resourceCount       Int                 @default(0)
  totalEndpointsHit   Int                 @default(0)
  totalEndpointsOk    Int                 @default(0)
  totalEndpointsFail  Int                 @default(0)
  serverMiddlewareAvgMs Float              @default(0)
  serverHandlerAvgMs  Float               @default(0)
  serverDbWriteAvgMs  Float               @default(0)
  serverDbReadAvgMs   Float               @default(0)
  totalEndToEndMs     Int                 @default(0)
  authMethod          String              @default("")  // api_key | jwt | none
  authUserId          String              @default("")
  authRole            String              @default("")
  rateLimitLimit      Int                 @default(0)
  rateLimitRemaining  Int                 @default(0)
  configValid         Boolean             @default(true)
  createdAt           DateTime            @default(now())

  spans               EndpointTraceSpan[]

  @@index([traceId])
  @@index([createdAt])
}

model EndpointTraceSpan {
  id                  String              @id @default(cuid())
  traceId             String
  endpoint            String
  method              String              @default("GET")
  statusCode          Int                 @default(0)

  // Client-side (browser) timing
  clientFetchStartMs  Int                 @default(0)
  clientDnsMs         Int                 @default(0)
  clientTcpMs         Int                 @default(0)
  clientSslMs         Int                 @default(0)
  clientTtfbMs        Int                 @default(0)
  clientResponseMs    Int                 @default(0)
  clientRoundTripMs   Int                 @default(0)
  clientJsonParseMs   Int                 @default(0)
  clientTransferSize  Int                 @default(0)
  clientEncodedSize   Int                 @default(0)
  clientDecodedSize   Int                 @default(0)
  clientProtocol      String              @default("")

  // Server-side timing (from response headers)
  serverMiddlewareMs  Int                 @default(0)
  serverHandlerMs     Int                 @default(0)
  serverDbWriteMs     Int                 @default(0)
  serverDbReadMs      Int                 @default(0)

  // Derived
  networkTransitMs    Int                 @default(0)   // ttfbMs - middlewareMs - handlerMs
  browserOverheadMs   Int                 @default(0)   // roundTripMs - ttfbMs

  error               String              @default("")
  rateLimitLimit      Int                 @default(0)
  rateLimitRemaining  Int                 @default(0)
  authMethod          String              @default("")
  createdAt           DateTime            @default(now())

  trace               EndpointTrace       @relation(fields: [traceId], references: [traceId], onDelete: Cascade)

  @@index([traceId])
  @@index([endpoint])
  @@index([statusCode])
}

// ═══════════════════════════════════════════════════════════════
//  PHASE 2: INTELLIGENCE — Anomaly Detection & Predictive MTTR
// ═══════════════════════════════════════════════════════════════

model AnomalyBaseline {
  id              String   @id @default(cuid())
  metricName      String   @unique  // e.g. "edi_volume_per_hour", "pii_density", "compliance_rate"
  dataSource      String   @default("")
  meanValue       Float
  stdDev          Float
  sampleCount     Int      @default(0)
  lastUpdated     DateTime @default(now())
  windowMinutes   Int      @default(60)

  detections      AnomalyDetection[]

  @@index([metricName])
}

model AnomalyDetection {
  id              String   @id @default(cuid())
  metricName      String
  observedValue   Float
  baselineMean    Float
  baselineStdDev  Float
  zScore          Float
  threshold       Float   @default(2.0)
  severity        String   @default("info")  // info | warning | critical
  direction       String   @default("above")  // above | below
  acknowledged    Boolean  @default(false)
  dataSource      String   @default("")
  contextPayload  String   @default("{}")  // JSON: extra context
  createdAt       DateTime @default(now())

  baseline        AnomalyBaseline @relation(fields: [metricName], references: [metricName])

  @@index([metricName])
  @@index([severity])
  @@index([acknowledged])
  @@index([createdAt])
}

model PredictiveMttr {
  id              String   @id @default(cuid())
  riskCategory    String
  severity        String
  predictedMttrH  Float
  confidence      Float   @default(0)
  features        String   @default("{}")  // JSON: {avg_mttr, p95, sample_count, trend_slope}
  createdAt       DateTime @default(now())

  @@index([riskCategory])
  @@index([severity])
}

model ComplianceReport {
  id              String   @id @default(cuid())
  reportType      String   @default("daily")  // daily | weekly | monthly
  generatedAt     DateTime @default(now())
  periodStart     DateTime
  periodEnd       DateTime
  totalFindings   Int      @default(0)
  resolvedFindings Int      @default(0)
  openFindings    Int      @default(0)
  avgMttrHours    Float   @default(0)
  complianceRate  Float   @default(0)
  topRiskCategories String  @default("[]")  // JSON
  anomaliesInPeriod Int     @default(0)
  summaryJson     String   @default("{}")
}
