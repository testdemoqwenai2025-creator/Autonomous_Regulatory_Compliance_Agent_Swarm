// This is your Prisma schema file,
// learn more at it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Tracks every request flowing through the middleware -> API -> DB pipeline
model SystemEvent {
  id            String   @id @default(cuid())
  requestId     String              /// unique request ID injected by middleware
  path          String              /// API path called
  method        String              /// HTTP method
  middlewareTs   DateTime            /// timestamp when middleware intercepted
  handlerTs     DateTime            /// timestamp when API handler processed
  dbWriteTs     DateTime?           /// timestamp when DB write completed (null if read-only)
  dbReadMs      Int?                /// DB read latency in ms
  statusCode    Int                 /// HTTP response status
  clientIp      String?             /// client IP captured by middleware
  userAgent     String?             /// browser user-agent from middleware
  layerTrace    String              /// JSON: which layers were touched
  createdAt     DateTime @default(now())
}

/// Stores system component health snapshots written by the API and read back for verification
model ComponentHealth {
  id          String   @id @default(cuid())
  component   String               /// e.g. "database", "middleware", "api", "browser"
  status      String               /// "healthy" | "degraded" | "down"
  latencyMs   Int                  /// response time in ms
  details     String               /// JSON with extra info
  checkedAt   DateTime @default(now())
}

/// Stores correlated client+server traces for a single request round-trip.
/// The browser sends its timings in x-client-timing header; the server
/// appends its own middleware/handler/DB timings and persists the full trace.
model CorrelatedTrace {
  id              String   @id @default(cuid())
  requestId       String              /// matches x-request-id from middleware
  path            String
  method          String
  statusCode      Int

  // -- Client-side (browser) timings --
  clientFetchStart    String          /// ISO timestamp: when fetch() was called
  clientTtfbMs         Int             /// Time to First Byte (ms) — measured by browser
  clientRoundTripMs    Int             /// Total round-trip from fetch() to JSON parsed (ms)
  clientJsonParseMs    Int             /// Time to parse JSON body (ms)
  clientRenderStartMs  Int             /// Time from fetch start to React state update (ms)
  clientNetworkProtocol String         /// e.g. "h2", "http/1.1"
  clientTimingJson    String          /// Full raw browser timing JSON

  // -- Server-side timings --
  serverMiddlewareStartTs  String       /// ISO: middleware entry
  serverMiddlewareEndTs    String       /// ISO: middleware exit
  serverMiddlewareMs       Int          /// middleware processing time (ms)
  serverHandlerStartTs     String       /// ISO: API handler entry
  serverHandlerEndTs       String       /// ISO: API handler exit
  serverHandlerMs          Int          /// total handler time (ms)
  serverDbWriteMs          Int          /// DB write latency (ms)
  serverDbReadMs           Int          /// DB read latency (ms)

  // -- Correlation --
  clientServerDeltaMs  Int              /// How far apart client & server clocks are (ms)
  totalEndToEndMs      Int              /// Full client round-trip (authoritative)

  createdAt       DateTime @default(now())
}
